# Gmail SMTP Configuration
SMTP_HOST="smtp.gmail.com"
SMTP_PORT=587
SMTP_SECURE="false"
SMTP_USER="ndsolotravel@gmail.com"
SMTP_PASS="GMAIL_APP_PASSWORD"
SMTP_FROM="NDSOLOTRAVEL <ndsolotravel@gmail.com>"
