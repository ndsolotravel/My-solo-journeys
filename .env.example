# Email Provider Configuration (Configure either Option A or Option B for live email notifications)
# Option A: SMTP (Recommended for Hostinger Webmail or Custom SMTP)
# SMTP_HOST="smtp.hostinger.com"
# SMTP_PORT=465
# SMTP_USER="contact@ndsolotravel.com"
# SMTP_PASS="YourEmailPasswordHere"
# SMTP_FROM="NDSOLOTRAVEL Contact <contact@ndsolotravel.com>"

# Option B: Resend REST API (https://resend.com)
# RESEND_API_KEY="re_123456789"
# RESEND_FROM="NDSOLOTRAVEL Contact <contact@ndsolotravel.com>"
# (Note: If domain is pending verification in Resend, notifications automatically fall back to onboarding@resend.dev)

