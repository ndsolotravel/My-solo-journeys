# Spam Protection - Cloudflare Turnstile (optional)
# If provided, the contact form requires Turnstile verification.
# If left empty, the form falls back to honeypot + rate limiting only.
# VITE_TURNSTILE_SITE_KEY is the public key exposed to the browser (safe to expose).
TURNSTILE_SITE_KEY=""
TURNSTILE_SECRET_KEY=""
VITE_TURNSTILE_SITE_KEY=""

# Anti-abuse: salt used to hash visitor IPs for rate limiting (server-only)
RATE_LIMIT_SALT="ndsolotravel-salt"

# Server Port
PORT=3000

